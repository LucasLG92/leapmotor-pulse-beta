[Unit]
Description=Metadata-only backup monitor for %i

[Service]
Type=oneshot
EnvironmentFile=-/etc/application-backup-monitor.conf
ExecStart=/usr/bin/python3 /usr/local/lib/application-backup-monitor/backup-monitor.py --profile %i
StateDirectory=application-backup-monitor
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
TimeoutStartSec=30s
