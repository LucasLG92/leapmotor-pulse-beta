  "components": [
    {
      "name": "Botón primario",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal de una pantalla.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">Guardar ajustes</button>",
      "css": ".ds-btn-primary { display:inline-flex; min-height:48px; align-items:center; justify-content:center; gap:8px; padding:10px 16px; border:1px solid transparent; border-radius:10px; background:var(--forest); color:var(--on-primary); cursor:pointer; font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; font-size:.875rem; font-weight:650; line-height:1.2; transition:background-color 140ms ease, border-color 140ms ease, color 140ms ease, opacity 140ms ease; }\n.ds-btn-primary:hover:not(:disabled) { background:var(--forest-hover); filter:brightness(.97); }\n.ds-btn-primary:active:not(:disabled) { filter:brightness(.91); }\n.ds-btn-primary:focus-visible { outline:3px solid var(--focus); outline-offset:3px; }\n.ds-btn-primary:disabled { cursor:not-allowed; opacity:.55; }"
    },
    {
      "name": "Campo de formulario",
      "kind": "input",
      "refersTo": "input",
      "description": "Campo de modelo o acabado del vehículo.",
      "html": "<label class=\"ds-field\"><span>Modelo o acabado</span><input class=\"ds-input\" type=\"text\" value=\"Leapmotor B10 Pro Max\" /></label>",
      "css": ".ds-field { display:grid; min-width:0; gap:7px; }\n.ds-field > span { color:var(--muted-strong); font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; font-size:.875rem; font-weight:650; }\n.ds-input { min-width:0; max-width:100%; width:100%; min-height:48px; padding:0 12px; border:1px solid var(--line-strong); border-radius:9px; background:var(--surface-raised); color:var(--ink); font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; font-size:1rem; }\n.ds-input:focus-visible { outline:3px solid var(--focus); outline-offset:3px; }\n.ds-input::placeholder { color:var(--muted); }"
    },
    {
      "name": "Tarjeta",
      "kind": "card",
      "refersTo": "card",
      "description": "Superficie para agrupar una lectura o ajuste relacionado.",
      "html": "<article class=\"ds-card\"><h2>Resumen de cargas</h2><p>Energía registrada</p><strong>— kWh</strong></article>",
      "css": ".ds-card { padding:20px; border:1px solid var(--line); border-radius:16px; background:var(--surface); box-shadow:0 2px 10px rgb(25 30 38 / 2%); color:var(--ink); font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; }\n.ds-card h2 { margin:0; font-size:1rem; font-weight:650; }\n.ds-card p { margin:12px 0 4px; color:var(--muted); font-size:.875rem; }\n.ds-card strong { font-size:1.125rem; font-variant-numeric:tabular-nums; }"
    },
    {
      "name": "Navegación activa",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Enlace de sección actual en el rail o navegación.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navegación principal\"><a href=\"/\" aria-current=\"page\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z\" /></svg><span>Resumen</span></a></nav>",
      "css": ".ds-nav { display:grid; gap:5px; font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; }\n.ds-nav > a { display:flex; min-height:48px; align-items:center; gap:12px; padding:0 13px; border:1px solid var(--line); border-radius:10px; background:var(--forest-soft); color:var(--forest); font-size:.875rem; font-weight:560; text-decoration:none; transition:background-color 140ms ease, color 140ms ease, border-color 140ms ease; }\n.ds-nav > a:hover { background:var(--surface-soft); }\n.ds-nav > a:focus-visible { outline:3px solid var(--focus); outline-offset:3px; }\n.ds-nav svg { flex:0 0 19px; }"
    },
    {
      "name": "Estado de demo",
      "kind": "chip",
      "refersTo": "status-demo",
      "description": "Etiqueta persistente que identifica datos simulados.",
      "html": "<span class=\"ds-status-demo\" role=\"status\"><span class=\"ds-status-dot\"></span>Datos simulados</span>",
      "css": ".ds-status-demo { display:inline-flex; min-height:30px; max-width:100%; align-items:center; gap:7px; padding:0 10px; border:1px solid var(--accent); border-radius:99px; background:var(--accent-soft); color:var(--accent); font-family:-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif; font-size:.75rem; font-weight:620; }\n.ds-status-dot { display:inline-block; width:7px; height:7px; flex:0 0 7px; border-radius:99px; background:var(--accent); }"
    }
  ],
  "narrative": {
    "northStar": "Cabina clara de movilidad",
    "overview": "Pulse presenta el B10 Pro Max con una lectura serena: jerarquía y precisión de un cuadro de movilidad, aire y tipografía del sistema al estilo de las referencias Apple y Google, y datos de carga fáciles de localizar como en Tesla. La interfaz traduce esas referencias en componentes propios, con superficies claras y carbón y acentos verdes limitados a acciones y selección.\n\nLa ilustración lateral del B10 y sus seis acabados seleccionables dan identidad al perfil. La preparación sin vehículo y la demo se distinguen con texto y estado persistente; una lectura ausente no se sustituye por cifras estimadas.",
    "keyCharacteristics": [
      "Jerarquía compacta, neutral y legible en superficies claras y charcoal.",
      "El modelo B10 Pro Max y sus seis acabados orientan la personalización visual.",
      "Los estados de preparación y demo conservan su procedencia visible."
    ],
    "rules": [
      {
        "name": "The Labelled State Rule",
        "body": "Color acompaña al texto de estado; nunca comunica por sí solo demo, conexión, éxito o error.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** use las variables semánticas del tema para canvas, superficies, texto, líneas y acentos.",
      "**Do** conservar etiquetas visibles para preparación, demo y conexión, y mostrar solo lecturas entregadas.",
      "**Do** presentar el B10 Pro Max con su ilustración y selector de seis acabados; mantener el acabado como orientativo.",
      "**Do** conservar foco visible, áreas de control de al menos `44px` y el comportamiento `prefers-reduced-motion` presente en CSS."
    ],
    "donts": [
      "**Don't** convertir jade o mint en el fondo dominante; la base actual es neutra clara o charcoal.",
      "**Don't** sustituir la ilustración B10 por un SUV genérico, logos o fotografía oficial.",
      "**Don't** presentar valores de preparación como telemetría, ni acciones de demo como controles físicos.",
      "**Don't** añadir blur, cristal o gradientes decorativos a tarjetas y navegación."
    ]
  }
}
