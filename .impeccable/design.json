  "components": [
    {
      "name": "Botón primario",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal de una vista.",
      "html": "<button class=\"ds-btn-primary\" type=\"button\">Guardar</button>",
      "css": ".ds-btn-primary { display:inline-flex; min-height:48px; align-items:center; justify-content:center; gap:8px; padding:10px 16px; border:1px solid transparent; border-radius:10px; background:var(--forest); color:var(--on-primary); cursor:pointer; font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif; font-size:.875rem; font-weight:650; line-height:1.2; transition:background-color 140ms ease,border-color 140ms ease,color 140ms ease,opacity 140ms ease; } .ds-btn-primary:hover:not(:disabled) { background:var(--forest-hover); filter:brightness(.97); } .ds-btn-primary:active:not(:disabled) { filter:brightness(.91); } .ds-btn-primary:focus-visible { outline:3px solid var(--focus); outline-offset:3px; } .ds-btn-primary:disabled { cursor:not-allowed; opacity:.55; }"
    },
    {
      "name": "Botón secundario",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Acción de apoyo junto a una acción principal.",
      "html": "<button class=\"ds-btn-secondary\" type=\"button\">Ver detalle</button>",
      "css": ".ds-btn-secondary { display:inline-flex; min-height:48px; align-items:center; justify-content:center; gap:8px; padding:10px 16px; border:1px solid var(--line-strong); border-radius:10px; background:var(--surface); color:var(--ink); cursor:pointer; font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif; font-size:.875rem; font-weight:650; line-height:1.2; transition:background-color 140ms ease,border-color 140ms ease,color 140ms ease; } .ds-btn-secondary:hover:not(:disabled) { border-color:var(--forest); background:var(--forest-soft); } .ds-btn-secondary:focus-visible { outline:3px solid var(--focus); outline-offset:3px; }"
    },
    {
      "name": "Botón quiet",
      "kind": "button",
      "refersTo": "button-quiet",
      "description": "Acción de bajo énfasis en una lista o detalle.",
      "html": "<button class=\"ds-btn-quiet\" type=\"button\">Cancelar</button>",
      "css": ".ds-btn-quiet { display:inline-flex; min-height:48px; align-items:center; justify-content:center; gap:8px; padding:10px 16px; border:1px solid var(--line); border-radius:10px; background:transparent; color:var(--muted-strong); cursor:pointer; font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif; font-size:.875rem; font-weight:650; line-height:1.2; transition:background-color 140ms ease,border-color 140ms ease,color 140ms ease; } .ds-btn-quiet:hover:not(:disabled) { border-color:var(--forest); background:var(--forest-soft); } .ds-btn-quiet:focus-visible { outline:3px solid var(--focus); outline-offset:3px; }"
    },
    {
      "name": "Botón destructivo",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Acción irreversible que requiere confirmación explícita.",
      "html": "<button class=\"ds-btn-danger\" type=\"button\">Eliminar registro</button>",
      "css": ".ds-btn-danger { display:inline-flex; min-height:48px; align-items:center; justify-content:center; gap:8px; padding:10px 16px; border:1px solid var(--danger); border-radius:10px; background:var(--danger); color:var(--on-danger); cursor:pointer; font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif; font-size:.875rem; font-weight:650; line-height:1.2; transition:filter 140ms ease,opacity 140ms ease; } .ds-btn-danger:hover:not(:disabled) { filter:brightness(.97); } .ds-btn-danger:active:not(:disabled) { filter:brightness(.91); } .ds-btn-danger:focus-visible { outline:3px solid var(--focus); outline-offset:3px; }"
    },
    {
      "name": "Campo de formulario",
      "kind": "input",
      "refersTo": "input",
      "description": "Campo editable con etiqueta y límite visible.",
      "html": "<label class=\"ds-field\"><span>Tarifa</span><input class=\"ds-input\" type=\"text\" placeholder=\"0,00 €/kWh\" /></label>",
      "css": ".ds-field { display:grid; min-width:0; gap:7px; color:var(--muted-strong); font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif; font-size:.875rem; font-weight:650; } .ds-input { min-width:0; width:100%; min-height:48px; padding:0 12px; border:1px solid var(--line-strong); border-radius:9px; background:var(--surface); color:var(--ink); font:400 1rem/1.5 -apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif; caret-color:var(--forest); } .ds-input:focus-visible { outline:3px solid var(--focus); outline-offset:3px; } .ds-input::placeholder { color:var(--muted); }"
    },
    {
      "name": "Superficie de tarjeta",
      "kind": "card",
      "refersTo": "card",
      "description": "Agrupa lecturas o contenido relacionado cuando la ruta usa contención.",
      "html": "<article class=\"ds-card\"><h2>Sesión de carga</h2><p>Energía registrada</p><strong>— kWh</strong></article>",
      "css": ".ds-card { padding:20px; border:1px solid var(--line); border-radius:16px; background:var(--surface); color:var(--ink); font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif; } .ds-card h2 { margin:0; font-size:1rem; font-weight:650; } .ds-card p { margin:12px 0 4px; color:var(--muted); font-size:.875rem; } .ds-card strong { font-size:1.125rem; font-variant-numeric:tabular-nums; }"
    },
