  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true, "noEmit": true,
    "lib": ["ES2022", "DOM"], "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "capacitor.config.ts", "vite.config.ts"]
}
