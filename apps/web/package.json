{
  "name": "leapmotor-pulse-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "types:api": "openapi-typescript ../../docs/openapi.json -o src/lib/api.generated.ts",
    "build": "vite build && node ../../scripts/compress-assets.mjs dist",
    "test:e2e": "node --test e2e/*.test.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/leaflet": "1.9.22",
    "openapi-typescript": "7.13.0",
    "playwright": "1.62.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vite-plugin-pwa": "2.0.0",
    "workbox-build": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  }
}
